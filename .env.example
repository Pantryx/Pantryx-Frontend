# Base URL of the Vapor API (no trailing slash). Used by Next.js rewrites for /api/* .
# Default in next.config.ts matches production Heroku; set this for a different backend when needed.
BACKEND_URL=https://pantryx-9007814d1092.herokuapp.com

# Where beta waitlist signups are POSTed as {"email": "...", "source": "pantryx.org"}.
# In PRODUCTION this defaults to ${BACKEND_URL}/api/waitlist, which emails the team
# via Resend — so you normally leave this unset. Set it only to override with a third
# party that accepts JSON (Formspree, Buttondown, Zapier, a Google Form).
# In development, with this unset, /api/site/waitlist answers 501 and the form offers a
# mailto fallback (so local testing never emails the team).
WAITLIST_WEBHOOK_URL=
